# Copie este arquivo para .env e ajuste conforme necessário.
# Em desenvolvimento, os valores padrão (MOCK_MODE=true) já funcionam sem
# nenhuma configuração adicional.

DATABASE_URL=sqlite:///./cadastro_insumos.db

MOCK_MODE=true

# --- Azure AD App Registration (client credentials — usado pra ler a
# SharePoint List e pra enviar email via Graph; não depende do login de
# usuário) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Email (Microsoft Graph / Outlook, mesma credencial acima) ---
# Precisa ser uma caixa real do Microsoft 365 — o Mail.Send de aplicação
# manda "como" esse usuário. Requer a permissão Mail.Send (Application)
# no App Registration acima.
EMAIL_REMETENTE=

# --- SharePoint List "Cadastro de Insumos" (site Engenharia-PlanejamentoeControle) ---
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
# Corte de data ISO — só importa itens criados depois disso (evita trazer
# o histórico inteiro da lista na primeira sincronização real).
SHAREPOINT_SYNC_DESDE=

# Chave usada pelo GitHub Actions pra chamar o endpoint de sincronização
# (header X-Sync-Key) — precisa ser igual ao secret SYNC_API_KEY do
# repositório no GitHub. Não depende do login de usuário/MOCK_MODE.
SYNC_API_KEY=

POLLING_INTERVAL_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
