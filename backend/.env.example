# Copie este arquivo para .env e ajuste conforme necessário.
# Em desenvolvimento, os valores padrão (MOCK_MODE=true) já funcionam sem
# nenhuma configuração adicional.

DATABASE_URL=sqlite:///./cadastro_insumos.db

MOCK_MODE=true

# --- Azure AD App Registration (client credentials, usado só pra ler a
# SharePoint List — não depende do login de usuário) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Resend (envio de email nas mudanças de coluna) ---
# Chave da conta em https://resend.com/api-keys
RESEND_API_KEY=
# Domínio sandbox só entrega para o email dono da conta Resend;
# em produção, troque por um remetente do domínio verificado.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- SharePoint List "Cadastro de Insumos" (site Engenharia-PlanejamentoeControle) ---
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=
# Corte de data ISO — só importa itens criados depois disso (evita trazer
# o histórico inteiro da lista na primeira sincronização real).
SHAREPOINT_SYNC_DESDE=

POLLING_INTERVAL_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
